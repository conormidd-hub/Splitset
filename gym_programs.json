{
 "exercises": {
  "spin": {
   "name": "Easy spin or brisk walk",
   "group": "Warm-up",
   "how": "Stationary bike, rower or brisk walk. Just enough to get warm – you should be able to talk.",
   "art": {
    "slug": "cycling"
   }
  },
  "glute-bridge": {
   "name": "Glute bridge",
   "group": "Warm-up",
   "how": "Feet flat, drive through the heels, squeeze the glutes at the top for a second.",
   "art": {
    "slug": "glute-bridge"
   }
  },
  "lateral-walk": {
   "name": "Banded lateral walk",
   "group": "Warm-up",
   "how": "Band around the knees or ankles, soft knees, small steps sideways. Keep tension on the band.",
   "art": {
    "slug": "banded-lateral-walk"
   }
  },
  "leg-swings": {
   "name": "Leg swings",
   "group": "Warm-up",
   "how": "Hold something for balance. Front-to-back then side-to-side, relaxed and growing in range.",
   "art": {
    "slug": "leg-swings-stretch"
   }
  },
  "calf-raise-flat": {
   "name": "Double-leg calf raise (flat floor)",
   "group": "Warm-up",
   "how": "On flat ground, not a step. Slow up and down, mid-range, to warm the tendon without dropping the heel.",
   "art": {
    "slug": "standing-calf-raise"
   }
  },
  "sl-bent-knee-raise": {
   "name": "Bent-knee calf raise",
   "group": "Physio",
   "how": "Single leg. In a squat position with the knee bent, raise up and lower slowly.",
   "art": {
    "slug": "seated-calf-raise",
    "similar": "Seated version – yours is single leg in a squat position, same bent knee."
   }
  },
  "bstance-rdl": {
   "name": "B-stance RDL",
   "group": "Physio",
   "how": "Staggered stance, weight mostly through the working leg, hinge at the hips with a flat back. Physio's note: front foot – on toes.",
   "art": {
    "slug": "single-leg-romanian-deadlift",
    "similar": "Shows a true single-leg RDL – in a B-stance the other foot stays down as a kickstand."
   }
  },
  "pogo-double": {
   "name": "Double-leg pogos",
   "group": "Physio",
   "how": "Stiff ankles, quick contacts, small bounces. Stop if the Achilles complains.",
   "art": {
    "slug": "jump-rope",
    "similar": "Same quick, springy bounce – no rope."
   }
  },
  "pogo-single": {
   "name": "Single-leg pogos",
   "group": "Physio",
   "how": "One leg at a time, quick springy contacts. Quality over height.",
   "art": {
    "slug": "jump-rope",
    "similar": "Same quick, springy bounce on one leg – no rope."
   }
  },
  "hip-flexor": {
   "name": "Hip flexor stretch",
   "group": "Cool-down",
   "how": "Half-kneeling, tuck the pelvis and shift forward until you feel the front of the hip.",
   "art": {
    "slug": "kneeling-hip-flexor-stretch"
   }
  },
  "figure-4": {
   "name": "Figure-4 glute stretch",
   "group": "Cool-down",
   "how": "On your back, ankle over the opposite knee, pull the thigh gently towards you."
  },
  "hamstring": {
   "name": "Hamstring stretch",
   "group": "Cool-down",
   "how": "Leg up on a low bench, hinge forward from the hips with a long back.",
   "art": {
    "slug": "hamstring-stretch"
   }
  },
  "foam-roll": {
   "name": "Foam roll quads and glutes",
   "group": "Cool-down",
   "how": "Slow passes on the quads and glutes. Don't roll directly on the Achilles."
  }
 },
