# Copy to .env (gitignored). This file is for the sync job run from your own machine;
# GitHub Actions gets SUPABASE_DB_URL from the repository secrets instead.
# The Expo app has its own app/.env.example.

# Supabase "Session pooler" connection string (IPv4, port 5432).
# Dashboard -> Connect -> Session pooler. Use the splitset-dev project while developing.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Only needed for `splitset-sync connect`, the admin path used before the app exists.
# From https://intervals.icu/settings, bottom of the page. Keep the leading "i" on the athlete id.
INTERVALS_ATHLETE_ID=i123456
INTERVALS_API_KEY=your_key_here
