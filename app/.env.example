# Copy to app/.env (gitignored). Both values are public client keys from the Supabase
# dashboard: Project Settings -> API Keys. The publishable key (sb_publishable_...) is
# preferred; the legacy anon key also works. Never put the service role key or the
# database URL here: this file ships inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Optional: one-tap demo sign-in. When both are present at build time the sign-in screen
# shows a "Sign in as the demo athlete" card. The account is created by
# supabase/seed_demo.py. On Vercel set these for the Preview environment only.
EXPO_PUBLIC_DEMO_EMAIL=demo@splitset.example
EXPO_PUBLIC_DEMO_PASSWORD=
